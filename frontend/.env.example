# Copy to .env.local for local overrides. Only VITE_* variables reach the browser - never put secrets here.

# Base path of the REST API as seen by the browser. Keep it relative so the same build works behind Nginx.
VITE_API_BASE_URL=/api/v1

# Dev server only: where Vite forwards /api requests.
DEV_API_PROXY_TARGET=http://localhost:8080
