# Edge server: serves the SPA and is the only public route to the API.
# Rendered by the nginx image at start-up; ${BACKEND_UPSTREAM} is the only substituted variable.

# Sign-in endpoints: at most 5 requests per second per client address (short bursts allowed).
# This slows password guessing from one address; the per-account lock in the backend covers the rest.
limit_req_zone $binary_remote_addr zone=bos_auth:10m rate=5r/s;

upstream bos_backend {
    server ${BACKEND_UPSTREAM};
    keepalive 16;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 30m; # keep in line with spring.servlet.multipart.max-request-size

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json application/problem+json image/svg+xml;
    gzip_min_length 1024;

    # --- API ---
    location /api/v1/auth/ {
        limit_req zone=bos_auth burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://bos_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
    }

    location /api/ {
        proxy_pass http://bos_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 60s;
    }

    # API docs: the backend answers 404 here unless API_DOCS_ENABLED=true.
    location ~ ^/(v3/api-docs|swagger-ui) {
        proxy_pass http://bos_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Operational endpoints (health, metrics) are never exposed publicly.
    location /actuator {
        return 404;
    }

    # --- SPA ---
    # Fingerprinted build assets can be cached forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Everything else falls back to index.html so client-side routes survive a refresh.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
